{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*",
        "./*"
      ],
      "@dnk/video-audit-core": [
        "../../packages/video-audit-core/src/index.ts"
      ],
      "@dnk/video-audit-core/*": [
        "../../packages/video-audit-core/src/*"
      ],
      "@dnk/teleprompter-core": [
        "../../packages/teleprompter-core/src/index.ts"
      ],
      "@dnk/teleprompter-core/*": [
        "../../packages/teleprompter-core/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "stories",
    "**/*.stories.tsx",
    "vitest.config.ts",
    "src/canvas",
    "src/components/canvas"
  ]
}
