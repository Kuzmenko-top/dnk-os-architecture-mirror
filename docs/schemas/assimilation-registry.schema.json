{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DNK_OS_Assimilation_Registry_Schema",
  "description": "Validation schema for assimilated open source components and patterns in DNK OS",
  "type": "object",
  "required": ["registry_version", "last_updated", "sources"],
  "properties": {
    "registry_version": { "type": "string" },
    "last_updated": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "category",
          "upstream_repo",
          "license",
          "assimilation_level",
          "dnk_bounded_context",
          "adopted_concepts",
          "not_adopted",
          "security_review",
          "status"
        ],
        "properties": {
          "source_id": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["agent_orchestration", "visual_workspace", "ecommerce_engine", "media_studio", "knowledge_rag", "platform_security"]
          },
          "upstream_repo": { "type": "string" },
          "license": { "type": "string" },
          "assimilation_level": {
            "type": "string",
            "enum": ["R1_research", "R2_protocol", "R3_pattern_adaptation", "R4_component_reuse", "R5_vendor_fork"]
          },
          "dnk_bounded_context": { "type": "string" },
          "adopted_concepts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "not_adopted": {
            "type": "array",
            "items": { "type": "string" }
          },
          "security_review": {
            "type": "object",
            "required": ["tenant_isolation", "human_approval_required", "license_approved"],
            "properties": {
              "tenant_isolation": { "type": "boolean" },
              "human_approval_required": { "type": "boolean" },
              "license_approved": { "type": "boolean" }
            }
          },
          "status": {
            "type": "string",
            "enum": ["research", "approved", "implemented", "deprecated"]
          }
        }
      }
    }
  }
}
