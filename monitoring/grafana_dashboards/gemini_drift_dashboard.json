              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "dnk_gemini_json_valid_ratio",
          "legendFormat": "JSON Valid Ratio",
          "refId": "A"
        }
      ]
